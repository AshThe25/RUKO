# Build-time cloud configuration, read by react-native-dotenv via '@env'.
# Copy to .env before building. The publishable key is safe to ship in a client:
# row-level security, not secrecy of this string, protects the data.
# A service-role key must never appear here.
SUPABASE_URL=https://pqsiubukwusapbgctqgk.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_palMcI2FkgSExL83FZLC4g_0zIyo_5G

# Ruko's own proxy (FastAPI, deployed on Render). It holds the Sarvam and
# Anthropic keys server-side and verifies the caller's Supabase token, so no
# provider key ever ships inside the APK.
#
# Leave this empty and cloud transcription silently cannot run: BACKEND_URL
# resolves to '' and the app has nowhere to send audio. It is read at BUILD
# time by react-native-dotenv, so changing it means rebuilding the APK, not
# just editing this file.
RUKO_BACKEND_URL=https://ruko.onrender.com
