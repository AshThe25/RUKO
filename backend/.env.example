# Copy to .env for local development. NEVER commit .env.
#
# Secret used to sign device and guardian tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
RUKO_RELAY_SECRET=change-me-in-every-environment

# Comma-separated origins allowed to reach the relay from a browser.
# The Guardian console origin goes here. Never use "*" with credentials.
RUKO_ALLOWED_ORIGINS=http://localhost:3000

# Minutes a pairing code stays valid.
RUKO_PAIRING_TTL_MINUTES=10

# Set false in production so the relay refuses to run over plain ws://.
RUKO_ALLOW_INSECURE_TRANSPORT=true

# --- API-key proxy ---
# The phone holds none of these. An APK is a zip: `apktool d app.apk` recovers
# embedded strings in about a minute, so a key shipped in the app is public.

# Supabase project, used to verify the access token the client already has.
RUKO_SUPABASE_URL=https://your-project.supabase.co
# Only for projects on legacy HS256 JWTs. Leave empty for asymmetric (JWKS).
RUKO_SUPABASE_JWT_SECRET=

# Vendor keys. Real values belong in the host's environment, never in git.
RUKO_SARVAM_API_KEY=
RUKO_ANTHROPIC_API_KEY=
RUKO_ANTHROPIC_MODEL=claude-sonnet-4-6
