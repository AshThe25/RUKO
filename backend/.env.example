# Copy to .env for local development. NEVER commit .env.
#
# Secret used to sign device and guardian tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
RUKO_RELAY_SECRET=change-me-in-every-environment

# Comma-separated origins allowed to reach the relay from a browser.
# The Guardian console origin goes here. Never use "*" with credentials.
RUKO_ALLOWED_ORIGINS=http://localhost:3000

# Minutes a pairing code stays valid.
RUKO_PAIRING_TTL_MINUTES=10

# Set false in production so the relay refuses to run over plain ws://.
RUKO_ALLOW_INSECURE_TRANSPORT=true
