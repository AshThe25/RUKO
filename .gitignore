# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Node / React Native ---
node_modules/
npm-debug.log*
yarn-error.log*
.expo/
dist/
build/
coverage/
*.tsbuildinfo

# --- Android ---
android/.gradle/
android/build/
android/app/build/
android/local.properties
*.apk
*.aab
*.keystore
!debug.keystore

# --- Python / ML ---
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# ML artefacts: checkpoints and exported weights are NOT committed.
# Everything needed to reproduce them IS committed (data generator + configs).
ml/models/**/*.bin
ml/models/**/*.safetensors
ml/models/**/*.onnx
ml/models/**/*.pt
ml/models/**/checkpoints/
ml/runs/
!ml/models/**/model_card.json
!ml/models/**/metrics.json
!ml/models/**/.gitkeep

# --- Secrets: never commit ---
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# --- React Native keeps the native projects inside mobile/ ---
mobile/android/.gradle/
mobile/android/build/
mobile/android/app/build/
mobile/android/.cxx/
mobile/android/local.properties
mobile/ios/Pods/
mobile/ios/build/
mobile/ios/*.xcworkspace/xcuserdata/
.metro-health-check*

# --- Guardian / Next.js ---
guardian/.next/

# --- Android, from feature/puneesh-android-guardian ---
.gradle/
local.properties
captures/
.cxx/
*.jks

# --- Python tooling ---
.ruff_cache/

# Probe output is machine-specific; commit deliberately, not by accident
docs/device-report.md

# Gradle wrapper jar is committed deliberately; build dirs are not
android/.gradle/
android/build/
android/*/build/
backend/model_manifest.json
