# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Node / React Native ---
node_modules/
npm-debug.log*
yarn-error.log*
.expo/
dist/
build/
coverage/
*.tsbuildinfo

# --- Android ---
android/.gradle/
android/build/
android/app/build/
android/local.properties
*.apk
# ...except the two the website serves. These are the download, so an ignored
# APK is a broken link on a live page -- which is exactly how paynow.apk
# shipped as a 404 while ruko.apk worked: one had been force-added and the
# other silently was not.
!web/ruko.apk
!web/paynow.apk
*.aab
*.keystore
!debug.keystore

# --- Python / ML ---
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# ML artefacts: checkpoints and exported weights are NOT committed.
# Everything needed to reproduce them IS committed (data generator + configs).
ml/models/**/*.bin
ml/models/**/*.safetensors
ml/models/**/*.onnx
# ...except the shipped ruko-manip-v1 weights, which the app needs at
# runtime. They are committed through git LFS (see .gitattributes), and
# their sha256 is recorded in model_card.json.
!ml/models/ruko-manip-v1/onnx/model_int8.onnx
# Shipped weights must each be un-ignored by name. The broad rules above exist
# so stray checkpoints stay out of git, but they also mean a NEW model dir is
# swallowed silently: `git add` reports success and commits nothing, which is
# how manip-v1 shipped on the lexicon for weeks. ml/verify_model_artifacts.py
# turns that silence into a failure.
!ml/models/ruko-real-multisource-v1/onnx/model_int8.onnx
ml/models/**/*.pt
ml/models/**/checkpoints/
ml/runs/
# Externally sourced real-data corpora may carry source-specific licence or
# privacy restrictions. Commit reproducible builders and manifests, never the
# raw transcript/message rows.
ml/data/real-*/
!ml/models/**/model_card.json
!ml/models/**/metrics.json
!ml/models/**/.gitkeep

# --- Secrets: never commit ---
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# --- React Native keeps the native projects inside mobile/ ---
mobile/android/.gradle/
mobile/android/build/
mobile/android/app/build/
mobile/android/.cxx/
mobile/android/local.properties
mobile/ios/Pods/
mobile/ios/build/
mobile/ios/*.xcworkspace/xcuserdata/
.metro-health-check*

# --- Guardian console (Next.js) ---
.next/
next-env.d.ts

# --- Relay / tooling ---
.ruff_cache/

# Device probe output is machine-specific: commit it deliberately, not by accident.
docs/device-report.md

# Published by ml/ when a model ships; absent means "no model published".
backend/model_manifest.json
.vercel

# The landing page serves this build directly, so it has to be in the repo:
# Vercel deploys from a clone, and without it the download 404s.
!web/ruko.apk
