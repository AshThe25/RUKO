<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Requested at runtime, with an explanation shown first. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ruko">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".EngineeringActivity"
            android:exported="false"
            android:label="@string/engineering_title" />

        <!--
            RukoPayDemo. A separate task and its own label so it looks and
            behaves like a distinct payment app on the device — which is the
            point: Ruko must detect it from outside, not from inside itself.
        -->
        <activity
            android:name=".PayDemoActivity"
            android:exported="true"
            android:label="@string/paydemo_name"
            android:taskAffinity="com.ruko.paydemo"
            android:theme="@style/Theme.RukoPay" />

    </application>
</manifest>
